#!/bin/sh
# shellcheck shell=busybox disable=SC2016
set -euo pipefail

DUMPS=${BACKUP_DUMPS_DIR:-/dumps}
VOLUMES=${BACKUP_VOLUMES_DIR:-/var/lib/docker/volumes}
EXCLUDES=$(mktemp)
started=$(date -u +%s)

log() { echo "$(date -u +%FT%TZ) $*"; }

dump() {
  out="$DUMPS/$1.sql.gz"
  docker exec "$2" sh -c "$3" | gzip > "$out"
  [ "$(gzip -dc "$out" | head -c 64 | wc -c)" -gt 0 ] || { log "empty dump for $1"; exit 1; }
  log "dumped $1 ($(wc -c < "$out") bytes)"
}

mkdir -p "$DUMPS"
rm -f "$DUMPS"/*.sql.gz

docker inspect -f '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{"\n"}}{{end}}{{end}}' "$(hostname)" 2> /dev/null \
  | sed '/^$/d' | sed "s|^|$VOLUMES/|" >> "$EXCLUDES" || true

for id in $(docker ps -q); do
  [ "$(docker inspect -f '{{index .Config.Labels "karako-backup.skip"}}' "$id")" = true ] && continue
  name=$(docker inspect -f '{{.Name}}' "$id" | sed 's|^/||')
  image=$(docker inspect -f '{{.Config.Image}}' "$id")
  case "$image" in
    *postgres*|*pgvector*|*postgis*|*mariadb*|*mysql*|*redis*|*valkey*|*keydb*|*dragonfly*) ;;
    *) continue ;;
  esac
  docker inspect -f '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{"\n"}}{{end}}{{end}}' "$id" \
    | sed '/^$/d' | sed "s|^|$VOLUMES/|" >> "$EXCLUDES"
  case "$image" in
    *postgres*|*pgvector*|*postgis*)
      dump "$name" "$id" 'pg_dumpall -U "${POSTGRES_USER:-postgres}" --clean --if-exists' ;;
    *mariadb*|*mysql*)
      dump "$name" "$id" 'exec $(command -v mariadb-dump || command -v mysqldump) -uroot -p"${MARIADB_ROOT_PASSWORD:-${MYSQL_ROOT_PASSWORD:-}}" --all-databases --single-transaction --routines --events --triggers' ;;
  esac
done

for path in ${BACKUP_EXCLUDES:-}; do echo "$path" >> "$EXCLUDES"; done

paths="$DUMPS"
for path in "$VOLUMES" ${BACKUP_EXTRA_PATHS:-}; do
  [ -e "$path" ] && paths="$paths $path"
done

restic cat config > /dev/null 2>&1 || restic init
log "backup of $paths"
# shellcheck disable=SC2086
restic backup --quiet --host "$BACKUP_HOST" --tag karako-backup \
  --exclude-file "$EXCLUDES" --exclude "$VOLUMES/backingFsBlockDev" --exclude "$VOLUMES/metadata.db" \
  $paths

log "forget"
restic forget --quiet --host "$BACKUP_HOST" --prune \
  --keep-daily "${BACKUP_KEEP_DAILY:-7}" --keep-weekly "${BACKUP_KEEP_WEEKLY:-4}" --keep-monthly "${BACKUP_KEEP_MONTHLY:-6}"

if [ "$(date -u +%u)" = "${BACKUP_CHECK_WEEKDAY:-7}" ]; then
  log "check"
  restic check --read-data-subset="${BACKUP_CHECK_SUBSET:-5%}"
fi

restic snapshots --host "$BACKUP_HOST" --latest 1 --compact
rm -f "$EXCLUDES"
date -u +%FT%TZ > "${BACKUP_STATE_DIR:-/state}/last-success"
log "done in $(( $(date -u +%s) - started ))s"
